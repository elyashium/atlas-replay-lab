# Local development only. Copy to .env and keep .env out of version control.
NODE_ENV=development
HOST=127.0.0.1
PORT=3000
ATLAS_APP_ORIGIN=http://127.0.0.1:3000
DATABASE_URL=postgres://atlas:local-only-change-me@127.0.0.1:5432/atlas
ATLAS_ENABLE_LOCAL_WORKER=0
ATLAS_LOCAL_ARTIFACT_DIR=C:\atlas-local-artifacts
ATLAS_WORKER_IMAGE=atlas-worker:local
GROQ_API_KEY=
ATLAS_GROQ_VISION_MODEL=qwen/qwen3.8-27b
ATLAS_GROQ_CODE_MODEL=openai/gpt-oss-120b
ATLAS_VISUAL_REVIEW_DAILY_LIMIT=10
ATLAS_CODE_PROPOSAL_DAILY_LIMIT=5
ATLAS_RUN_DAILY_LIMIT=100
ATLAS_RUN_CONCURRENT_LIMIT=5
ATLAS_SHARED_REPORT_RATE_LIMIT_PER_MINUTE=120
ATLAS_ANONYMOUS_SHARE_RATE_LIMIT_PER_MINUTE=1200
# Optional private S3-compatible artifact store. Leave the bucket blank for local disk mode.
ATLAS_ARTIFACT_S3_BUCKET=
ATLAS_ARTIFACT_S3_ENDPOINT=
ATLAS_ARTIFACT_S3_REGION=us-east-1
ATLAS_ARTIFACT_S3_ACCESS_KEY_ID=
ATLAS_ARTIFACT_S3_SECRET_ACCESS_KEY=
SUPABASE_URL=https://your-project.supabase.co
SUPABASE_ANON_KEY=your-supabase-publishable-key
VITE_SUPABASE_URL=https://your-project.supabase.co
VITE_SUPABASE_PUBLISHABLE_KEY=your-supabase-publishable-key
